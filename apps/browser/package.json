{
  "name": "@autoapply/browser",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "smoke": "tsx src/smoke-playwright.ts"
  },
  "dependencies": {
    "@autoapply/config": "workspace:*",
    "@autoapply/shared": "workspace:*",
    "@autoapply/types": "workspace:*",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright": "^1.49.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
