{
  "all": true,
  "include": ["apps/**/*.ts", "packages/**/*.ts"],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/coverage/**",
    "packages/database/src/generated/**",
    "**/*.test.ts",
    "**/testing/**",
    "**/*.module.ts",
    "**/*.d.ts",
    "**/eslint.config.*",
    "**/next.config.*",
    "**/tailwind.config.*",
    "**/postcss.config.*",
    "apps/*/src/main.ts",
    "apps/*/src/load-env.ts",
    "apps/browser/src/smoke-playwright.ts"
  ],
  "reporter": ["text", "text-summary"],
  "check-coverage": true,
  "lines": 80,
  "statements": 80,
  "branches": 0,
  "functions": 0
}
