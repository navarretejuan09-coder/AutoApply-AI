# Database (Postgres + pgvector via Docker Compose)
DATABASE_URL=postgresql://autoapply:autoapply@localhost:5432/autoapply

# Redis
REDIS_URL=redis://localhost:6379

# Ollama (local LLM + embeddings for M3 job matching)
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Auth — shared secret for Auth.js (web) and JWT verification (API)
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# API
API_URL=http://localhost:3001
API_PORT=3001
WEB_URL=http://localhost:3000

# Browser automation stub
BROWSER_PORT=3002

# Resume uploads (max file size in bytes; default 5MB)
RESUME_MAX_BYTES=5242880

# Web (Auth.js)
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
