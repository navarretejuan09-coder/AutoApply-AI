generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ResumeStatus {
  pending
  processing
  parsed
  failed
}

enum JobStatus {
  pending
  matching
  matched
  failed
}

enum ApplicationStatus {
  queued
  submitting
  submitted
  failed
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String
  name            String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  resumes         Resume[]
  jobs            Job[]
  applications    Application[]
  browserSessions BrowserSession[]
}

model Resume {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName      String
  mimeType      String
  content       Bytes
  status        ResumeStatus @default(pending)
  extractedText String?
  skills        String[]     @default([])
  summary       String?
  errorMessage  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId, createdAt])
}

model Job {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  company        String
  url            String?
  location       String?
  description    String
  status         JobStatus     @default(pending)
  matchScore     Float?
  matchRationale String?
  errorMessage   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  applications   Application[]

  @@index([userId, createdAt])
}

model Application {
  id                    String            @id @default(cuid())
  userId                String
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId                 String
  job                   Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  provider              String            @default("linkedin")
  status                ApplicationStatus @default(queued)
  externalApplicationId String?
  errorMessage          String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([userId, jobId, provider])
  @@index([userId, createdAt])
}

model BrowserSession {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider         String
  encryptedCookies Bytes
  iv               Bytes
  authTag          Bytes
  updatedAt        DateTime @updatedAt

  @@unique([userId, provider])
}
